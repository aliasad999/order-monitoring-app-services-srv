_schema-version: '3.1'
ID: order-monitoring-app-services-mta_prod
extends: order-monitoring-app-services

modules:
  - name: order-monitoring-app-services-srv
    properties:
      OTEL_RESOURCE_ATTRIBUTES: sap.tenancy.tenant_id=43b092c5-2fed-4194-aca6-1019abe786a8
      AP_CLIENT: 100
      SUBACCOUNT: PROD
    parameters:
      memory: 8GB
      disk-quota: 8GB
      instances: 2
    requires:
      - name: order-monitoring-autoscaler
        parameters:
          path: ./autoscaler_prod.json