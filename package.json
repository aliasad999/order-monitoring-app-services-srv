{
  "name": "order-monitoring-app-services",
  "version": "1.0.0",
  "description": "FIORI App related service",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.10",
    "@sap-cloud-sdk/http-client": "^4.6.0",
    "@sap/cds": "^8.9.6",
    "@sap/cds-hana": "^2.0.0",
    "@sap/fesr-to-otel-js": "1.5.20",
    "@sap/hana-client": "^2.28.20",
    "@sap/textbundle": "^6.2.0",
    "@sap/xotel-agent-ext-js": "2.0.1",
    "@sap/xsenv": "^6.2.0",
    "@sap/xssec": "^4.13.0",
    "body-parser": "^2.2.2",
    "cf-nodejs-logging-support": "^7.4.5",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "http-status": "^2.1.0",
    "mocha": "^11.7.5",
    "node-cache": "^5.1.2",
    "passport": "^0.7.0",
    "uuid": "^14.0.0",
    "date-fns": "^4.1.0"
  },
  "overrides": {
    "protobufjs": "8.0.1",
    "serialize-javascript": "7.0.5",
    "diff": "8.0.3"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
    "@sap/hdi-deploy":"^5.6.1",
    "axios": "^1.15.2",
    "concurrently": "^9.2.1"
  },
  "scripts": {
    "bind": "cds bind --to order-monitoring-xsuaa:order-monitoring-xsuaa-key,order-monitoring-destination:order-monitoring-destination-key,order-monitoring-app-services-hdi:SharedDevKey,order-monitoring-connectivity:con-key,order-monitoring-credentials-store:credentials-store-key",
    "start": "node ${NODE_ARGS} ./node_modules/.bin/cds-serve",
    "test": "mocha srv/tests/test.js --timeout 150000 --exit",
    "test-amoo": "mocha srv/tests/test-amoo.js --timeout 150000 --exit",
    "test:util": "mocha srv/tests/utils/test-*.js",
    "start:backend": "cds watch",
    "build:cds": "cds build",
    "install:all": "npm-recursive-install",
    "start:approuter": "cd approuter && npm run start",
    "deploy-dev": "mbt build && cf deploy mta_archives/order-monitoring-app-services_1.0.0.mtar --retries 1",
    "deploy-qa": "mbt build && cf deploy mta_archives/order-monitoring-app-services_1.0.0.mtar -e mtaext_qa.mtaext --retries 1",
    "deploy-prod": "mbt build && cf deploy mta_archives/order-monitoring-app-services_1.0.0.mtar -e mtaext_prod.mtaext --retries 1",
    "watch-allorders": "cds watch --open allorders/webapp/index.html?sap-ui-xx-viewCache=false",
    "undeploy": "cf undeploy allmyorders --delete-services --delete-service-keys --delete-service-brokers",
    "build": "mbt build",
    "deploy": "mbt build && cf deploy mta_archives/order-monitoring-amo_0.0.1.mtar --retries 1",
    "set-local-env": "./setup-local-test.sh", 
    "run-amo-local": "concurrently \"cds watch --profile hybrid\" \"cds bind --exec -- npm run start:local --prefix /home/user/projects/OTC-MON-Order-Monitoring-All-My-Orders/app/local-approuter\"",
    "run-amoo-local": "concurrently \"cds watch --profile hybrid\" \"cds bind --exec -- npm run start:local --prefix /home/user/projects/OTC-MON-All-My-Open-Orders/app/local-approuter\""
  },
  "cds": {
    "log": {
      "levels": {
        "hana": "trace",
        "cds": "info"
      }
    },
    "hana": {
      "deploy-format": "hdbtable"
    }
  }
}
