{
  "name": "order-monitoring-app-services",
  "version": "1.0.0",
  "description": "FIORI App related service",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "1.12.3",
    "@sap-cloud-sdk/http-client": "3.11.0",
    "@sap/cds": "7.6.1",
    "@sap/cds-hana": "2.0.0",
    "@sap/fesr-to-otel-js": "1.5.3",
    "@sap/hana-client": "2.19.21",
    "@sap/textbundle": "4.3.0",
    "@sap/xotel-agent-ext-js": "1.5.8",
    "@sap/xsenv": "4.2.0",
    "@sap/xssec": "3.6.1",
    "body-parser": "1.20.2",
    "cf-nodejs-logging-support": "7.2.1",
    "express": "4.18.2",
    "http-status": "1.7.3",
    "mocha": "^10.3.0",
    "node-cache": "5.1.2",
    "passport": "0.7.0",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "1.5.0",
    "@sap/hdi-deploy": "4.9.2",
    "axios": "^1.6.7",
    "chai": "^4.4.1",
    "chai-as-promised": "^7.1.1",
    "chai-subset": "^1.6.0",
    "date-fns": "^3.6.0",
    "jest": "^29.7.0",
    "sqlite3": "^5"
  },
  "scripts": {
    "bind": "cds bind -2  order-monitoring-xsuaa:order-monitoring-xsuaa-key && cds bind -2  order-monitoring-destination:order-monitoring-destination-content-order-monitoring-destination-credentials &&  cds bind -2  order-monitoring-app-services-hdi:hana-key &&    cds bind -2  order-monitoring-connectivity:con-key",
    "start": "node ${NODE_ARGS} ./node_modules/@sap/cds/bin/cds-serve",
    "test": "mocha srv/tests/test.js --timeout 150000 --exit",
    "test-amoo": "mocha srv/tests/test-amoo.js --timeout 150000 --exit",
    "start:backend": "cds watch",
    "build:cds": "cds build",
    "install:all": "npm-recursive-install",
    "start:approuter": "cd approuter && npm run start",
    "watch-allorders": "cds watch --open allorders/webapp/index.html?sap-ui-xx-viewCache=false",
    "undeploy": "cf undeploy allmyorders --delete-services --delete-service-keys --delete-service-brokers",
    "build": "mbt build",
    "deploy": "cf deploy mta_archives/allmyorders_1.0.0.mtar --retries 1"
  },
  "cds": {
    "log": {
      "levels": {
        "hana": "trace",
        "cds": "info"
      }
    },
    "hana": {
      "deploy-format": "hdbtable"
    },
    "requires": {
      "auth": "xsuaa",
      "db": {
        "kind": "hana",
        "pool": {
          "acquireTimeoutMillis": 5000,
          "min": 0,
          "max": 1000,
          "fifo": true
        }
      },
      "authService": {
        "kind": "rest",
        "credentials": {
          "destination": "PersonalizationService",
          "path": "it/omg/omc-auth/v1"
        }
      },
      "apiManagementOdataServices": {
        "kind": "odata",
        "credentials": {
          "destination": "PersonalizationService",
          "path": "/it/omg"
        }
      }
    }
  }
}
