FUNCTION "SF_USER_LANG_KEY"()
    RETURNS ev_user_lang_key NVARCHAR(2) 
    LANGUAGE SQLSCRIPT
    SQL SECURITY INVOKER AS
BEGIN
    /*****************************
        Write your function logic
    ****************************/

    DECLARE lv_user_lang_key NVARCHAR(2);

  SELECT LEFT(UPPER(SESSION_CONTEXT('LOCALE')), 2)
    INTO lv_user_lang_key
    FROM "DUMMY";

  ev_user_lang_key = COALESCE(
    (
      SELECT :lv_user_lang_key
      FROM "DUMMY"
      WHERE :lv_user_lang_key IN ('DE', 'EN', 'FR', 'IT', 'PT', 'ES', 'TR')
    ),
    'EN'
  );
END;