@cds.persistence.exists
entity VBAKAUTH {
        key VKORG  : String(4);
        key VTWEG  : String(2);
        key SPART  : String(2);
        key USERID : String;
        LAST_UPDATE: Timestamp;
}

@cds.persistence.exists

entity ![ST_NOTES] {
        CLIENT         : String(3);
        UTCTIME        : Decimal(15) not null;
        VBELN          : String(10);
        POSNR          : String(6);
        LANGUAGE       : String(2);
        NOTE_TITLE     : String(60);
        NOTE_TEXT      : String(1000);
        USERNAME       : String(12);
        LAST_NOTE_FLAG : String(1);
}
