entity PARTNER_SETTINGS {
        CLIENT         : String(3);
        BASF_USER      : String(12);
        PARTNER_ROLE   : String(2);
        PARTNER_NUMBER : String(8);
        ACTIVE         : String(1);
        COMMT          : String(50);
}

