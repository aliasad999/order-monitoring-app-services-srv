    "order_monitoring_services.notes": {
      "kind": "entity",
      "@cds.external": true,
      "@cds.persistence.skip": true,
      "elements": {
        "CLIENT": {
          "key": true,
          "type": "cds.String",
          "length": 3,
          "notNull": true
        },
        "ID": {
          "key": true,
          "type": "cds.Integer64",
          "notNull": true
        },
        "VBELN": {
          "key": true,
          "type": "cds.String",
          "length": 10,
          "notNull": true
        },
        "POSNR": {
          "key": true,
          "type": "cds.String",
          "length": 6,
          "notNull": true
        },
        "UTCTIME": {
          "type": "cds.Decimal",
          "precision": 15,
          "scale": 0,
          "notNull": true
        },
        "LANGUAGE": {
          "type": "cds.String",
          "length": 2
        },
        "NOTE_TITLE": {
          "type": "cds.String",
          "length": 60
        },
        "NOTE_TEXT": {
          "type": "cds.String",
          "length": 1000
        }
      }
    },
