  "AMOOUtilsService.SalesOrderListItemLevel": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "@sap.addressable": "false",
   "@sap.semantics": "parameters",
   "elements": {
    "p_mandt": {
     "key": true,
     "type": "cds.String",
     "length": 3,
     "@sap.label": "p_mandt",
     "@sap.parameter": "mandatory",
     "notNull": true,
     "default": {
      "val": "100"
     }
    },
    "p_nps": {
     "key": true,
     "type": "cds.String",
     "length": 2,
     "@sap.label": "p_nps",
     "@sap.parameter": "mandatory",
     "notNull": true,
     "default": {
      "val": "00"
     }
    },
    "due_catalog": {
     "key": true,
     "type": "cds.Integer",
     "@sap.label": "due_catalog",
     "@sap.parameter": "mandatory",
     "notNull": true,
     "default": {
      "val": "0"
     }
    },
    "p_lang": {
     "key": true,
     "type": "cds.String",
     "length": 2,
     "@sap.label": "p_lang",
     "@sap.parameter": "mandatory",
     "notNull": true,
     "default": {
      "val": "EN"
     }
    },
    "Results": {
     "@cds.ambiguous": "missing on condition?",
     "type": "cds.Association",
     "target": "AMOOUtilsService.SalesOrderListItemLevelResults",
     "cardinality": {
      "max": "*"
     },
     "keys": []
    }
   }
  },
