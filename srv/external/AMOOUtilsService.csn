     "@sap.filterable": "false"
    },
    "NR_OF_SO_DUEAFTER": {
     "type": "cds.Integer",
     "@sap.label": "NumberOfSalesOrderWithDueAfter",
     "@sap.aggregation.role": "measure",
     "@sap.filterable": "false"
    },
