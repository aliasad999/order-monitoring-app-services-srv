  "AMOOUtilsService.CockpitResults": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "@sap.addressable": "false",
   "@sap.semantics": "aggregate",
   "elements": {
    "GenID": {
     "key": true,
     "type": "cds.String",
     "length": 40,
     "@sap.filterable": "false",
     "notNull": true
    },
    "Total": {
     "type": "cds.Integer",
     "@sap.label": "MaxDays",
     "@sap.aggregation.role": "dimension"
    },
    "NR_OF_SO_OVERDUE": {
     "type": "cds.Integer",
     "@sap.label": "NumberOfSalesOrderWithOverdue",
     "@sap.aggregation.role": "measure",
     "@sap.filterable": "false"
    },
    "NR_OF_SO_DUEWITHIN": {
     "type": "cds.Integer",
     "@sap.label": "NumberOfSalesOrderWithDueWithin",
