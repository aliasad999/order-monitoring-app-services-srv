_schema-version: '3.1'
ID: order-monitoring-app-services-mta_qa
extends: order-monitoring-app-services

modules:
  - name: order-monitoring-app-services-srv
    properties:
      OTEL_RESOURCE_ATTRIBUTES: sap.tenancy.tenant_id=b50b49ce-49e2-4161-a6f4-77006eb7303d
      AP_CLIENT: 100
      SUBACCOUNT: QA
    parameters:
      memory: 5GB
      disk-quota: 5GB
      instances: 1
    requires:
      - name: order-monitoring-autoscaler
        parameters:
          path: ./autoscaler_qa.json

